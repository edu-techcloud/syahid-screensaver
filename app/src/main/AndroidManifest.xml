<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Screensaver Islamik"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <!-- Screensaver sebenar (Daydream) yang akan muncul dalam senarai Screen saver TV -->
        <service
            android:name=".WebDream"
            android:exported="true"
            android:label="Screensaver Islamik"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Skrin pratonton: buka aplikasi ini untuk melihat screensaver serta-merta -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Screensaver Islamik">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
